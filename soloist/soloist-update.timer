[Unit]
Description=Check for a new Spotify Soloist release (builds expire after 90 days)

[Timer]
# Once shortly after boot, so a Pi that was off past the expiry recovers by itself,
# and every night when the clubroom is most likely quiet.
OnBootSec=3min
OnCalendar=*-*-* 05:30
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
