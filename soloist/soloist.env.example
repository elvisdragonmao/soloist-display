# Soloist settings. Never commit the real key.
#   Linux:   ~/.config/soloist/soloist.env
#   macOS:   ~/Library/Application Support/soloist-display/soloist.env
#   Windows: %APPDATA%\soloist-display\soloist.env
SOLOIST_API_KEY=spak_REPLACE_ME
# The name shown in Spotify's device list.
SOLOIST_DEVICE_NAME=Soloist
