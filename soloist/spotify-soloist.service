[Unit]
Description=Spotify Soloist
Wants=pipewire.service wireplumber.service
After=pipewire.service wireplumber.service

[Service]
Type=simple
EnvironmentFile=%h/.config/soloist/soloist.env
# SOLOIST_DEVICE_NAME and SOLOIST_API_KEY come from soloist.env.
ExecStart=/usr/local/bin/soloist --device-name ${SOLOIST_DEVICE_NAME} --api-key ${SOLOIST_API_KEY} --ws 127.0.0.1:0
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
